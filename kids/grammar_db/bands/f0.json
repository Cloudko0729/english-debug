      "contrastPairs": [
        {
          "id": "F0.1-complete-sentence-contrast-1",
          "wrong": {
            "text": "My dog very cute.",
            "status": "misleading",
            "audio": "audio/grammar_db/content/f0_1_complete_sentence_contrast_1_wrong.mp3"
          },
          "better": {
            "text": "My dog is very cute.",
            "status": "natural",
            "audio": "audio/grammar_db/content/f0_1_complete_sentence_contrast_1_better.mp3"
          },
          "reasonZh": "形容詞 cute 前需要 be 動詞，才能形成完整述語。"
        },
        {
          "id": "F0.1-complete-sentence-contrast-2",
          "wrong": {
            "text": "In the classroom.",
            "status": "awkward",
            "audio": "audio/grammar_db/content/f0_1_complete_sentence_contrast_2_wrong.mp3"
          },
          "better": {
            "text": "The students are in the classroom.",
            "status": "natural",
            "audio": "audio/grammar_db/content/f0_1_complete_sentence_contrast_2_better.mp3"
          },
          "reasonZh": "單獨的地點片語沒有說明誰在那裡；正式寫作需要補完整。"
        }
      ],
      "chineseTransferBugs": [
        {
          "id": "F0.1-complete-sentence-bug-1",
          "zh": "天氣很冷。",
          "wrong": {
            "text": "Is very cold.",

            "audio": "audio/grammar_db/content/f0_1_complete_sentence_bug_1_better.mp3"
          },
          "reasonZh": "英文天氣句需要形式主詞 it。",
          "severity": "E0"
        },
        {
          "id": "F0.1-complete-sentence-bug-2",
          "zh": "我的妹妹很開心。",
          "wrong": {

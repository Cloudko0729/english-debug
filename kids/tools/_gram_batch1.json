        {
          "q": "哪一句修正了 Is cold. 的問題？",
          "choices": [
            "It is cold.",
            "Is it cold.",
            "Very cold.",
            "Cold is."
          ],
          "answer": "It is cold."
        },
        {
          "q": "看到英文句子時，最先檢查哪兩個零件？",
          "choices": [
            "主詞和動詞",
            "顏色和大小",
            "逗號和句點",
            "中文意思和注音"
          ],
          "answer": "主詞和動詞"
        }
      ]

        {
          "en": "Close the door.",
          "zh": "把門關上。"
        },
        {
          "en": "What a big dog!",
          "zh": "好大的一隻狗！"
        },
        {
          "en": "My friends and I watch a game after school.",
          "zh": "我和朋友放學後看一場比賽。"
        }

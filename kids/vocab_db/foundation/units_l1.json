          },
          {
            "id": "l1-u07-d6",
            "speaker": "B",
            "text": "No, I sit and play with my toy.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u07-d6.mp3"
          },
          {
            "id": "l1-u07-d7",
            "speaker": "A",
            "text": "I miss our park games.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u07-d7.mp3"
          },
          {
            "id": "l1-u07-d8",

          "id": "l1-u03-p1",
          "title": "Numbers and Time: First Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "It is a busy day, and we check the time carefully. I am busy now. She has one pencil. Seven days make a week. I see six stars. I have ten toes. He has three books. Today is Monday. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "now",
            "one",
            "seven",
            "six",
            "ten",
            "three",
            "today"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u03-p1.mp3"
        },
        {
          "id": "l1-u03-p2",
          "title": "People and Family: Second Reading",
          "type": "guided-reading",
          "theme": "people_family",
          "text": "My family and friends are together today. Two cats sit here. The baby drinks milk. A boy is playing with the dog. The girl has a blue kite. Every kid gets a turn. The king lives in a big house. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "two",
            "baby",
            "boy",
            "girl",
            "kid",
            "king"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u03-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u03-d1",
            "speaker": "A",
            "text": "Can you use \"now\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d1.mp3"
          },
          {
            "id": "l1-u03-d2",
            "speaker": "B",
            "text": "I am busy now.",

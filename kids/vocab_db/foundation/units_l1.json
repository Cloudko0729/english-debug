          "id": "l1-u07-p2",
          "title": "Home and Objects: Second Reading",
          "type": "guided-reading",
          "theme": "home_objects",
          "text": "A toy car is in my room. I sit on the bed and make it go. The car runs to the door. Now it is under a toy bus. Dad comes home and looks in. \"Come with me,\" he says. We go to the real car and ride to Grandma's home.",
          "focusWords": [
            "door",
            "room",
            "toy",
            "bus",
            "car",
            "home"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u07-p2.mp3"

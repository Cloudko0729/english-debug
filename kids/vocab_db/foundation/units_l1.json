      "titleZh": "語言與句型",
      "titleEn": "Language Tools",
      "targetWords": [
        "a",
        "am",
        "an",
        "are",
        "at",
        "do",
        "he",
        "how",
        "i",
        "in",
        "is",
        "it",
        "not",
        "or"
      ],
      "passages": [
        {
          "id": "l1-u01-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. I have a red pen. I am happy today. I eat an apple after school. They are in the classroom. We meet at the bus stop. Do you like this song? He is my brother. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "a",
            "am",
            "an",
            "are",
            "at",
            "do",
            "he"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u01-p1.mp3"
        },
        {
          "id": "l1-u01-p2",
          "title": "Language Tools: Second Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. How do you go to school? I am ten years old. We play in the park. She is my teacher. I found a key, and it is small. This book is not new. We can walk or take the bus. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "how",
            "i",
            "in",
            "is",
            "it",
            "not",
            "or"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u01-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u01-d1",
            "speaker": "A",
            "text": "Can you use \"a\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d1.mp3"
          },
          {
            "id": "l1-u01-d2",
            "speaker": "B",
            "text": "I have a red pen.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d2.mp3"
          },
          {
            "id": "l1-u01-d3",
            "speaker": "A",
            "text": "What can you say with \"am\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d3.mp3"
          },
          {
            "id": "l1-u01-d4",
            "speaker": "B",
            "text": "I am happy today.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d4.mp3"
          },
          {
            "id": "l1-u01-d5",
            "speaker": "A",
            "text": "Can you give me an example with \"an\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d5.mp3"
          },
          {
            "id": "l1-u01-d6",
            "speaker": "B",
            "text": "I eat an apple after school.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d6.mp3"
          },
          {
            "id": "l1-u01-d7",
            "speaker": "A",
            "text": "How would you use \"are\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d7.mp3"
          },
          {
            "id": "l1-u01-d8",
            "speaker": "B",
            "text": "They are in the classroom.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u01-dialogue.mp3"
      }

      "titleZh": "動物與自然",
      "titleEn": "Animals and Nature",
      "targetWords": [
        "bird",
        "cat",
        "dog",
        "lion",
        "moon",
        "pet",
        "pig",
        "sky",
        "sun",
        "tree",
        "nose",
        "sad",
        "card"
      ],
      "passages": [
        {
          "id": "l1-u05-p1",
          "title": "Animals and Nature: First Reading",
          "type": "guided-reading",
          "theme": "animals_nature",
          "text": "Our dog is a good pet, but he likes to run. At the park, he sees a bird and runs to a tree. A cat is under the tree. The cat sees a pig on a card. Our dog sees it, too. He wants to play with them all.",
          "focusWords": [
            "bird",
            "cat",
            "dog",
            "lion",
            "moon",
            "pet",
            "pig"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u05-p1.mp3"
        },
        {
          "id": "l1-u05-p2",
          "title": "Animals and Nature: Second Reading",
          "type": "guided-reading",
          "theme": "animals_nature",
          "text": "The sun is in the sky, and a bird sits in our tree. My cat looks up with her nose in the air. At night, the moon comes out. My little pet is sad because the bird is not there. I give her a lion toy, and she is happy.",
          "focusWords": [
            "sky",
            "sun",
            "tree",
            "nose",
            "sad",
            "card"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u05-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u05-d1",
            "speaker": "A",
            "text": "Is that your dog by the tree?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d1.mp3"
          },
          {
            "id": "l1-u05-d2",
            "speaker": "B",
            "text": "Yes. He is my new pet.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d2.mp3"
          },
          {
            "id": "l1-u05-d3",
            "speaker": "A",
            "text": "Why is your cat up there?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d3.mp3"
          },
          {
            "id": "l1-u05-d4",
            "speaker": "B",
            "text": "She sees a bird in the sky.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d4.mp3"
          },
          {
            "id": "l1-u05-d5",
            "speaker": "A",
            "text": "Is the bird near the sun?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d5.mp3"
          },
          {
            "id": "l1-u05-d6",
            "speaker": "B",
            "text": "No, it is under the tree.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d6.mp3"
          },
          {
            "id": "l1-u05-d7",
            "speaker": "A",
            "text": "Your dog looks sad now.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d7.mp3"
          },
          {
            "id": "l1-u05-d8",
            "speaker": "B",
            "text": "He wants the cat to come down.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u05-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u05-dialogue.mp3"
      }
    },
    {
      "id": "l1-u06",
      "level": 1,
      "bands": [
        "F0",
        "F1"
      ],
      "theme": "food",
      "sequence": 6,
      "unitThemes": [
        {
          "name": "food",
          "count": 8
        },
        {
          "name": "school",
          "count": 3
        },
        {
          "name": "home_objects",
          "count": 2
        }
      ],
      "titleZh": "食物與用餐 × 校園與學習",
      "titleEn": "Food and Meals & School and Learning",
      "targetWords": [
        "cup",
        "egg",
        "food",
        "lunch",
        "milk",
        "pie",
        "tea",
        "water",
        "desk",
        "pen",
        "picture",
        "ball",
        "bed"
      ],
      "passages": [
        {
          "id": "l1-u06-p1",
          "title": "Food and Meals: First Reading",
          "type": "guided-reading",
          "theme": "food",
          "text": "It is lunch time at home. Dad puts an egg and rice on my plate. Mom gives me a cup of water. My sister has milk, and Grandma has tea. A pie is on the table, too. We have good food. We sit down and eat lunch together.",
          "focusWords": [
            "cup",
            "egg",
            "food",
            "lunch",
            "milk",
            "pie",
            "tea"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u06-p1.mp3"
        },
        {
          "id": "l1-u06-p2",
          "title": "School and Learning: Second Reading",
          "type": "guided-reading",
          "theme": "school",
          "text": "My room is ready for art time. A pen and a cup are on my desk. I draw a picture of a red ball by my bed. Then I draw milk, tea, and an egg. The picture is for Mom. I put it on her door.",
          "focusWords": [
            "water",
            "desk",
            "pen",
            "picture",
            "ball",
            "bed"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u06-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u06-d1",
            "speaker": "A",
            "text": "What do you want for lunch?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u06-d1.mp3"
          },
          {
            "id": "l1-u06-d2",
            "speaker": "B",
            "text": "I want an egg and some rice.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u06-d2.mp3"
          },
          {
            "id": "l1-u06-d3",
            "speaker": "A",
            "text": "Do you want milk or tea?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u06-d3.mp3"
          },
          {
            "id": "l1-u06-d4",
            "speaker": "B",
            "text": "Milk, please. Is it in the cup?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u06-d4.mp3"
          },
          {
            "id": "l1-u06-d5",
            "speaker": "A",
            "text": "Yes, and the water is here.",

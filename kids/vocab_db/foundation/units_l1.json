      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u07-d1",
            "speaker": "A",
            "text": "Do you go home by bus?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u07-d1.mp3"
          },
          {
            "id": "l1-u07-d2",
            "speaker": "B",
            "text": "No, I go home in Dad's car.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u07-d2.mp3"
          },
          {
            "id": "l1-u07-d3",
            "speaker": "A",
            "text": "Can you come to the park first?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u07-d3.mp3"
          },
          {
            "id": "l1-u07-d4",
            "speaker": "B",
            "text": "Yes. I want to run with you.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u07-d4.mp3"
          },
          {
            "id": "l1-u07-d5",
            "speaker": "A",
            "text": "Do you jog every day?",

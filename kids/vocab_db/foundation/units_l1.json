  "units": [
    {
      "id": "l1-u01",
      "level": 1,
      "bands": [
        "F0",
        "F1"
      ],
      "theme": "language",
      "sequence": 1,
      "unitThemes": [
        {
          "name": "language",
          "count": 14
        }
      ],
      "titleZh": "語言與句型",
      "titleEn": "Language Tools",
      "targetWords": [
        "a",
        "am",
        "an",
        "are",
        "at",
        "do",
        "he",
        "how",
        "i",
        "in",
        "is",
        "it",
        "not",
        "or"
      ],
      "passages": [
        {
          "id": "l1-u01-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "It is seven. I am in the kitchen with Dad. He has an egg and a red cup. The cup is on the table. We are ready for breakfast. I do not want tea. I want milk. Is it hot or cold? Dad says it is cold. I eat the egg at home.",
          "focusWords": [
            "a",
            "am",
            "an",
            "are",
            "at",
            "do",
            "he"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u01-p1.mp3"
        },
        {
          "id": "l1-u01-p2",
          "title": "Language Tools: Second Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "I am at the park with my sister. She is on a red bike, and I am in a little car. It is a toy car, but it is big for me. We do not go fast. Are we near the tree or the bus? We are near the tree.",
          "focusWords": [
            "how",
            "i",
            "in",
            "is",
            "it",
            "not",
            "or"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u01-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u01-d1",
            "speaker": "A",
            "text": "Are you at the school door?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d1.mp3"
          },
          {
            "id": "l1-u01-d2",
            "speaker": "B",
            "text": "Yes, I am here with Ben.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d2.mp3"
          },
          {
            "id": "l1-u01-d3",
            "speaker": "A",
            "text": "Is he in your class?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d3.mp3"
          },
          {
            "id": "l1-u01-d4",
            "speaker": "B",
            "text": "Yes. He has a book and an apple.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d4.mp3"
          },
          {
            "id": "l1-u01-d5",
            "speaker": "A",
            "text": "Do you have a pen?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d5.mp3"
          },
          {
            "id": "l1-u01-d6",
            "speaker": "B",
            "text": "No, I do not. It is at home.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d6.mp3"
          },
          {
            "id": "l1-u01-d7",
            "speaker": "A",
            "text": "Do you want a red pen or a blue pen?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d7.mp3"
          },
          {
            "id": "l1-u01-d8",
            "speaker": "B",
            "text": "A blue pen, please.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u01-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u01-dialogue.mp3"
      }
    },
    {
      "id": "l1-u02",
      "level": 1,
      "bands": [
        "F0",
        "F1"
      ],
      "theme": "language",
      "sequence": 2,
      "unitThemes": [
        {
          "name": "language",
          "count": 10
        },
        {
          "name": "numbers_time",
          "count": 4
        }
      ],
      "titleZh": "語言與句型 × 數字與時間",
      "titleEn": "Language Tools & Numbers and Time",
      "targetWords": [
        "say",
        "she",
        "that",
        "they",
        "too",
        "we",
        "what",
        "who",
        "yes",
        "you",
        "eight",
        "five",
        "four",
        "nine"
      ],
      "passages": [
        {
          "id": "l1-u02-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Today we have a class party. We put five red cups and four blue cups on the table. That is nine cups. What do we need now? We need cake, too. They bring the cake, and she brings water. Who has the plates? You do. Yes, we are ready.",
          "focusWords": [
            "say",
            "she",
            "that",
            "they",
            "too",
            "we",
            "what"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u02-p1.mp3"
        },
        {
          "id": "l1-u02-p2",
          "title": "Numbers and Time: Second Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "A girl and a boy are at the school store. She wants eight pencils, and he wants five pens. They see four red bags and nine blue bags. What bag do you like? The girl says, \"That red bag.\" The boy says, \"I like that bag, too.\"",
          "focusWords": [
            "who",
            "yes",
            "you",
            "eight",
            "five",
            "four",
            "nine"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u02-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u02-d1",
            "speaker": "A",
            "text": "What is in that big box?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d1.mp3"
          },
          {
            "id": "l1-u02-d2",
            "speaker": "B",
            "text": "It is a birthday cake.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d2.mp3"
          },
          {
            "id": "l1-u02-d3",
            "speaker": "A",
            "text": "Who is the cake for?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d3.mp3"
          },
          {
            "id": "l1-u02-d4",
            "speaker": "B",
            "text": "It is for Amy. She is nine today.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d4.mp3"
          },
          {
            "id": "l1-u02-d5",
            "speaker": "A",
            "text": "Do we have eight cups?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d5.mp3"
          },
          {
            "id": "l1-u02-d6",
            "speaker": "B",
            "text": "Yes, and we have four plates, too.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d6.mp3"
          },
          {
            "id": "l1-u02-d7",
            "speaker": "A",
            "text": "Can you say, \"Happy birthday\" with us?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d7.mp3"
          },
          {
            "id": "l1-u02-d8",
            "speaker": "B",
            "text": "Yes! We are ready.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u02-dialogue.mp3"
      }
    },
    {
      "id": "l1-u03",
      "level": 1,
      "bands": [
        "F0",
        "F1"
      ],
      "theme": "numbers_time",
      "sequence": 3,
      "unitThemes": [
        {
          "name": "numbers_time",
          "count": 8
        },
        {
          "name": "people_family",
          "count": 5
        }
      ],
      "titleZh": "數字與時間 × 人物與家庭",
      "titleEn": "Numbers and Time & People and Family",
      "targetWords": [
        "now",
        "one",
        "seven",
        "six",
        "ten",
        "three",
        "today",
        "two",
        "baby",
        "boy",
        "girl",
        "kid",
        "king"
      ],
      "passages": [
        {
          "id": "l1-u03-p1",
          "title": "Numbers and Time: First Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "Today is sports day. Six kids run, and three kids sit by the tree. One boy has a red ball. Two girls have a blue ball. Now the teacher says, \"Go!\" Seven kids run to the line. Ten hands go up. Every kid wants to play.",
          "focusWords": [
            "now",
            "one",
            "seven",
            "six",
            "ten",
            "three",
            "today"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u03-p1.mp3"
        },
        {
          "id": "l1-u03-p2",
          "title": "People and Family: Second Reading",
          "type": "guided-reading",
          "theme": "people_family",
          "text": "A baby, a boy, and a girl are at home. The girl has one paper hat. The boy has two toy cars. Now they play king and queen. The baby is the king. He sits on a big chair. Today, the three kids have fun together.",
          "focusWords": [
            "two",
            "baby",
            "boy",
            "girl",
            "kid",
            "king"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u03-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u03-d1",
            "speaker": "A",
            "text": "How many kids are on your team?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d1.mp3"
          },
          {
            "id": "l1-u03-d2",
            "speaker": "B",
            "text": "We have ten kids now.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d2.mp3"
          },
          {
            "id": "l1-u03-d3",
            "speaker": "A",
            "text": "Do you have six boys?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d3.mp3"
          },
          {
            "id": "l1-u03-d4",
            "speaker": "B",
            "text": "No. We have three boys and seven girls.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d4.mp3"
          },
          {
            "id": "l1-u03-d5",
            "speaker": "A",
            "text": "Who has the ball today?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d5.mp3"
          },
          {
            "id": "l1-u03-d6",
            "speaker": "B",
            "text": "One girl has it.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d6.mp3"
          },
          {
            "id": "l1-u03-d7",
            "speaker": "A",
            "text": "Can two new kids play with us?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d7.mp3"
          },
          {
            "id": "l1-u03-d8",
            "speaker": "B",
            "text": "Yes. Every kid can play.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u03-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u03-dialogue.mp3"
      }
    },
    {
      "id": "l1-u04",
      "level": 1,
      "bands": [
        "F0",

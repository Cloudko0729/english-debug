      "passages": [
        {
          "id": "l1-u02-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. Please say your name. She has a new bag. That is our bus. They walk to school together. I like apples, too. We eat lunch at school. What is your name? After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "say",
            "she",
            "that",
            "they",
            "too",
            "we",
            "what"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u02-p1.mp3"
        },
        {
          "id": "l1-u02-p2",
          "title": "Numbers and Time: Second Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "It is a busy day, and we check the time carefully. Who has my ruler? Yes, I am ready. Do you want some water? I eat eight grapes. Five students play ball. Four cups are on the table. I see nine flowers. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "who",
            "yes",
            "you",
            "eight",
            "five",
            "four",
            "nine"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u02-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u02-d1",
            "speaker": "A",
            "text": "Can you use \"say\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d1.mp3"
          },
          {
            "id": "l1-u02-d2",
            "speaker": "B",
            "text": "Please say your name.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d2.mp3"
          },
          {
            "id": "l1-u02-d3",
            "speaker": "A",
            "text": "What can you say with \"she\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d3.mp3"
          },
          {
            "id": "l1-u02-d4",
            "speaker": "B",
            "text": "She has a new bag.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d4.mp3"
          },
          {
            "id": "l1-u02-d5",
            "speaker": "A",
            "text": "Can you give me an example with \"that\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d5.mp3"
          },
          {
            "id": "l1-u02-d6",
            "speaker": "B",
            "text": "That is our bus.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d6.mp3"
          },
          {
            "id": "l1-u02-d7",
            "speaker": "A",
            "text": "How would you use \"they\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d7.mp3"
          },
          {
            "id": "l1-u02-d8",
            "speaker": "B",
            "text": "They walk to school together.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u02-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u02-dialogue.mp3"

        {
          "name": "people_family",
          "count": 5
        }
      ],
      "titleZh": "身體與感受 × 人物與家庭",
      "titleEn": "Body and Feelings & People and Family",
      "targetWords": [
        "arm",
        "ear",
        "eye",
        "fat",
        "fine",
        "hot",
        "leg",
        "neck",
        "man",
        "mr",
        "mrs",
        "ms",
        "name"
      ],
      "passages": [
        {
          "id": "l1-u04-p1",
          "title": "Body and Feelings: First Reading",
          "type": "guided-reading",
          "theme": "body_health",
          "text": "Tom is at the school health room. His arm and leg hurt. His neck is fine, but one eye is red. The nurse looks at his ear, too. Tom is hot and sad. He sees a fat cat by the door. The cat makes him smile.",
          "focusWords": [
            "arm",
            "ear",
            "eye",
            "fat",
            "fine",
            "hot",
            "leg"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u04-p1.mp3"
        },
        {
          "id": "l1-u04-p2",
          "title": "People and Family: Second Reading",
          "type": "guided-reading",
          "theme": "people_family",
          "text": "A man is at the school door. His name is Mr. Brown. Mrs. Green is with him. They need help, so Ms. Hill comes. She says, \"My name is Anna. Come with me.\" The man and Mrs. Green go to the school office. Now they are fine.",
          "focusWords": [
            "neck",
            "man",
            "mr",
            "mrs",
            "ms",
            "name"
          ],
          "audio": "audio/vocab_foundation/passages/l1-u04-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l1-u04-d1",
            "speaker": "A",
            "text": "What is wrong with your arm?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d1.mp3"
          },
          {
            "id": "l1-u04-d2",
            "speaker": "B",
            "text": "It hurts when I move it.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d2.mp3"
          },
          {
            "id": "l1-u04-d3",
            "speaker": "A",
            "text": "Does your leg hurt, too?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d3.mp3"
          },
          {
            "id": "l1-u04-d4",
            "speaker": "B",
            "text": "No, my leg is fine.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d4.mp3"
          },
          {
            "id": "l1-u04-d5",
            "speaker": "A",
            "text": "Is your neck hot?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d5.mp3"
          },
          {
            "id": "l1-u04-d6",
            "speaker": "B",
            "text": "No, but my ear is hot.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d6.mp3"
          },
          {
            "id": "l1-u04-d7",
            "speaker": "A",
            "text": "Can you see with this eye?",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d7.mp3"
          },
          {
            "id": "l1-u04-d8",
            "speaker": "B",
            "text": "Yes. I can see you.",
            "audio": "audio/vocab_foundation/dialogue_lines/l1-u04-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l1-u04-dialogue.mp3"
      }
    },
    {
      "id": "l1-u05",
      "level": 1,
      "bands": [
        "F0",

      "titleZh": "語言與句型 × 數字與時間",
      "titleEn": "Language Tools & Numbers and Time",
      "targetWords": [
        "and",
        "english",
        "its",
        "on",
        "please",
        "real",
        "roc",
        "these",
        "those",
        "under",
        "usa",
        "very",
        "birthday",
        "clock",
        "day"
      ],
      "passages": [
        {
          "id": "l2-u01-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "It is my birthday, and our classroom is very busy. The clock is on the wall, and the party is at three. These red cups are on the table. Those blue plates are under the table. Please put them next to the real cake. My classmate writes \"Happy Birthday\" in English. Dad says its color is very nice.",
          "focusWords": [
            "and",
            "english",
            "its",
            "on",
            "please",
            "real",
            "roc",
            "these"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u01-p1.mp3"
        },
        {
          "id": "l2-u01-p2",
          "title": "Language Tools: Second Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class has a special day about places. These students have flags, and those students have maps. One map is of the USA. Another card says ROC. Please put each card on the right desk, not under it. Our teacher checks the clock. We have one hour, and the room is very busy.",
          "focusWords": [
            "those",
            "under",
            "usa",
            "very",
            "birthday",
            "clock",
            "day"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u01-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l2-u01-d1",
            "speaker": "A",
            "text": "Please put these cups on the table.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d1.mp3"
          },
          {
            "id": "l2-u01-d2",
            "speaker": "B",
            "text": "Okay. What about those plates?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d2.mp3"
          },
          {
            "id": "l2-u01-d3",
            "speaker": "A",
            "text": "Put them under the birthday sign.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d3.mp3"
          },
          {
            "id": "l2-u01-d4",
            "speaker": "B",
            "text": "Is it a real cake in that box?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d4.mp3"
          },
          {
            "id": "l2-u01-d5",
            "speaker": "A",
            "text": "Yes, and its color is pink.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d5.mp3"
          },
          {
            "id": "l2-u01-d6",
            "speaker": "B",
            "text": "Wow! The party starts at three, right?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d6.mp3"
          },
          {
            "id": "l2-u01-d7",
            "speaker": "A",
            "text": "Yes. Look at the clock.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d7.mp3"
          },
          {
            "id": "l2-u01-d8",
            "speaker": "B",
            "text": "It is three now. Let us start!",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l2-u01-dialogue.mp3"
      }
    },
    {

          "id": "l2-u01-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. I have a pencil and an eraser. This book is in English. The dog moves its tail. We have music class on Friday. Please close the door. The story is based on a real animal. ROC means the Republic of China. These apples are sweet. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "and",
            "english",
            "its",
            "on",
            "please",
            "real",
            "roc",
            "these"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u01-p1.mp3"
        },
        {
          "id": "l2-u01-p2",
          "title": "Language Tools: Second Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. Those birds are in the tree. The cat is under the chair. My friend is from the USA. The classroom is very clean. We made a card for Dad's birthday. The clock is on the wall. I play every day. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "those",
            "under",
            "usa",
            "very",
            "birthday",
            "clock",
            "day"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u01-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l2-u01-d1",
            "speaker": "A",
            "text": "Can you use \"and\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u01-d1.mp3"

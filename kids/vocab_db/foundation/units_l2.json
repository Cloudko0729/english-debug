      ],
      "passages": [
        {
          "id": "l2-u05-p1",
          "title": "Actions and Routines: First Reading",
          "type": "guided-reading",
          "theme": "actions",
          "text": "At lunch, Mom gives me a bowl of rice and soup. I close my book and sit on the sofa. My sister makes a sandwich and puts on her cap. We see a ship from the window. I sing a song about the sea, and she plays with her doll. Then we wash our bowls and go to the store.",
          "focusWords": [
            "close",
            "give",
            "play",
            "see",
            "sing",
            "rice",
            "sandwich",
            "soup"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u05-p1.mp3"
        },
        {
          "id": "l2-u05-p2",
          "title": "Clothes and Looks: Second Reading",
          "type": "guided-reading",
          "theme": "clothes",
          "text": "A small store has a school play today. One child wears a short shirt and a red cap. Another child sits on a sofa with a doll. I give them a toy ship for the show. They sing, play, and see their teacher smile. After the show, we close the door and share soup and sandwiches.",
          "focusWords": [
            "cap",
            "shirt",
            "short",
            "doll",
            "sofa",
            "ship",
            "store"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u05-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l2-u05-d1",
            "speaker": "A",
            "text": "Please close your book. Lunch is ready.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d1.mp3"
          },
          {
            "id": "l2-u05-d2",
            "speaker": "B",
            "text": "What do we have today?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d2.mp3"
          },
          {
            "id": "l2-u05-d3",
            "speaker": "A",
            "text": "Rice, soup, and a sandwich.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d3.mp3"
          },
          {
            "id": "l2-u05-d4",
            "speaker": "B",
            "text": "Can I eat on the sofa?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d4.mp3"
          },
          {
            "id": "l2-u05-d5",
            "speaker": "A",
            "text": "No. Sit at the table.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d5.mp3"
          },
          {
            "id": "l2-u05-d6",
            "speaker": "B",
            "text": "Can I play with my doll after lunch?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d6.mp3"
          },
          {
            "id": "l2-u05-d7",
            "speaker": "A",
            "text": "Yes, and give me your bowl first.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d7.mp3"
          },
          {
            "id": "l2-u05-d8",
            "speaker": "B",
            "text": "Okay. I want to sing, too.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u05-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l2-u05-dialogue.mp3"
      }
    },

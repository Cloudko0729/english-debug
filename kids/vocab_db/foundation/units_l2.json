      "titleZh": "人物與家庭 × 動物與自然",
      "titleEn": "People and Family & Animals and Nature",
      "targetWords": [
        "brother",
        "classmate",
        "father",
        "singer",
        "sister",
        "son",
        "student",
        "teacher",
        "woman",
        "air",
        "ant",
        "bee",
        "week",
        "year",
        "toe"
      ],
      "passages": [
        {
          "id": "l2-u02-p1",
          "title": "People and Family: First Reading",
          "type": "guided-reading",
          "theme": "people_family",
          "text": "Our school has a family music show. My sister is a singer, and my brother plays the drum. My father sits with my little son. A woman helps each student get ready. My classmate stands by our teacher. The air in the hall is cool. After the song, every family smiles and claps.",
          "focusWords": [
            "brother",
            "classmate",
            "father",
            "singer",
            "sister",
            "son",
            "student",
            "teacher"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u02-p1.mp3"
        },
        {
          "id": "l2-u02-p2",
          "title": "Animals and Nature: Second Reading",
          "type": "guided-reading",
          "theme": "animals_nature",
          "text": "A teacher takes her class outside for nature week. One student sees an ant on a flower. Another child finds a bee in the air. My classmate shows me his toe because an ant is near it. A woman helps him stand up. We laugh and talk about the small animals we see this year.",
          "focusWords": [
            "woman",
            "air",
            "ant",
            "bee",
            "week",
            "year",
            "toe"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u02-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l2-u02-d1",
            "speaker": "A",
            "text": "Is that woman your teacher?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d1.mp3"
          },
          {
            "id": "l2-u02-d2",
            "speaker": "B",
            "text": "Yes. She is our music teacher.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d2.mp3"
          },
          {
            "id": "l2-u02-d3",
            "speaker": "A",
            "text": "Is the singer your sister?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d3.mp3"
          },
          {
            "id": "l2-u02-d4",
            "speaker": "B",
            "text": "No, she is my classmate's sister.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d4.mp3"
          },
          {
            "id": "l2-u02-d5",
            "speaker": "A",
            "text": "Where is your brother?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d5.mp3"
          },
          {
            "id": "l2-u02-d6",
            "speaker": "B",
            "text": "He is next to my father and son.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d6.mp3"
          },
          {
            "id": "l2-u02-d7",
            "speaker": "A",
            "text": "Can every student join the song?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d7.mp3"
          },
          {
            "id": "l2-u02-d8",
            "speaker": "B",
            "text": "Yes. Our class sings together.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u02-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l2-u02-dialogue.mp3"
      }
    },
    {
      "id": "l2-u03",
      "level": 2,

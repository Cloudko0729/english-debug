      "titleZh": "動作與日常 × 食物與用餐",
      "titleEn": "Actions and Routines & Food and Meals",
      "targetWords": [
        "close",
        "give",
        "play",
        "see",
        "sing",
        "rice",
        "sandwich",
        "soup",
        "cap",
        "shirt",

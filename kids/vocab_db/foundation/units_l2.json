      "titleZh": "食物與用餐 × 校園與學習",
      "titleEn": "Food and Meals & School and Learning",
      "targetWords": [
        "apple",
        "cake",
        "candy",
        "coffee",
        "coke",
        "cola",
        "eat",
        "ham",
        "glue",
        "pencil",
        "read",
        "ruler",
        "school",
        "study",
        "table"
      ],
      "passages": [
        {
          "id": "l2-u04-p1",
          "title": "Food and Meals: First Reading",
          "type": "guided-reading",
          "theme": "food",
          "text": "We stop at a convenience store after school. I want an apple and a ham sandwich. My sister wants candy, cake, and cola. Dad says we need real food, so we get rice and a salad, too. Mom does not drink coffee or Coke at night. She takes water. We eat together at the table.",
          "focusWords": [
            "apple",
            "cake",
            "candy",
            "coffee",
            "coke",
            "cola",
            "eat",
            "ham"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u04-p1.mp3"
        },
        {
          "id": "l2-u04-p2",
          "title": "School and Learning: Second Reading",
          "type": "guided-reading",
          "theme": "school",
          "text": "Our class makes a food book. I use a pencil and ruler to draw a long table. Amy uses glue for the apple and cake pictures. We read each page and write one food word. At lunch, we eat rice and ham at school. After lunch, we study the new words and put the book by the classroom door.",
          "focusWords": [
            "glue",
            "pencil",
            "read",
            "ruler",
            "school",
            "study",
            "table"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u04-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l2-u04-d1",
            "speaker": "A",
            "text": "Do you want cake or candy?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d1.mp3"
          },
          {
            "id": "l2-u04-d2",
            "speaker": "B",
            "text": "I want cake and an apple.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d2.mp3"
          },
          {
            "id": "l2-u04-d3",
            "speaker": "A",
            "text": "Can I have a Coke?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d3.mp3"
          },
          {
            "id": "l2-u04-d4",
            "speaker": "B",
            "text": "No, please take water today.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d4.mp3"
          },
          {
            "id": "l2-u04-d5",
            "speaker": "A",
            "text": "What does Dad want to eat?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d5.mp3"
          },
          {
            "id": "l2-u04-d6",
            "speaker": "B",
            "text": "He wants ham and rice.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d6.mp3"
          },
          {
            "id": "l2-u04-d7",
            "speaker": "A",
            "text": "Where can we sit?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d7.mp3"
          },
          {
            "id": "l2-u04-d8",
            "speaker": "B",
            "text": "That table by the door is free.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u04-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l2-u04-dialogue.mp3"
      }
    },

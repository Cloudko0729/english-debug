      "titleZh": "動物與自然 × 校園與學習",
      "titleEn": "Animals and Nature & School and Learning",
      "targetWords": [
        "cow",
        "flower",
        "fox",
        "frog",
        "fruit",
        "hen",
        "hippo",
        "sea",
        "sheep",
        "zoo",
        "book",
        "box",
        "chair",
        "classroom",
        "draw"
      ],
      "passages": [
        {
          "id": "l2-u03-p1",
          "title": "Animals and Nature: First Reading",
          "type": "guided-reading",
          "theme": "animals_nature",
          "text": "Our class visits a small zoo. A cow and a sheep eat near the tree. A hen walks by the flower, and a frog sits under it. We see a fox, a hippo, and many birds. At lunch, we eat fruit by the sea animal room. Then we draw our favorite animal in a book.",
          "focusWords": [
            "cow",
            "flower",
            "fox",
            "frog",
            "fruit",
            "hen",
            "hippo",
            "sea"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u03-p1.mp3"
        },
        {
          "id": "l2-u03-p2",
          "title": "School and Learning: Second Reading",
          "type": "guided-reading",
          "theme": "school",
          "text": "Today our classroom becomes an animal art room. Each student takes a book from the box and sits on a chair. I draw a fox near a flower. My friend draws a frog by the sea. The teacher adds a cow, a hen, a hippo, and a sheep to one big zoo picture. We put it on the classroom wall.",
          "focusWords": [
            "sheep",
            "zoo",
            "book",
            "box",
            "chair",
            "classroom",
            "draw"
          ],
          "audio": "audio/vocab_foundation/passages/l2-u03-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l2-u03-d1",
            "speaker": "A",
            "text": "What animal is near the flower?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d1.mp3"
          },
          {
            "id": "l2-u03-d2",
            "speaker": "B",
            "text": "It is a small frog.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d2.mp3"
          },
          {
            "id": "l2-u03-d3",
            "speaker": "A",
            "text": "Can you see the fox, too?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d3.mp3"
          },
          {
            "id": "l2-u03-d4",
            "speaker": "B",
            "text": "Yes. It is by the sheep.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d4.mp3"
          },
          {
            "id": "l2-u03-d5",
            "speaker": "A",
            "text": "Where is the hippo?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d5.mp3"
          },
          {
            "id": "l2-u03-d6",
            "speaker": "B",
            "text": "It is in the water.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d6.mp3"
          },
          {
            "id": "l2-u03-d7",
            "speaker": "A",
            "text": "Do you want to draw this zoo?",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d7.mp3"
          },
          {
            "id": "l2-u03-d8",
            "speaker": "B",
            "text": "Yes. My book is in the classroom.",
            "audio": "audio/vocab_foundation/dialogue_lines/l2-u03-d8.mp3"
          }
        ],
        "fullAudio": "audio/vocab_foundation/dialogues/l2-u03-dialogue.mp3"
      }
    },
    {
      "id": "l2-u04",

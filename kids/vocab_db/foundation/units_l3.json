      "passages": [
        {
          "id": "l3-u01-p1",
          "title": "Numbers and Time: First Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "It is a busy day, and we check the time carefully. School starts at eight a.m. We play outside after school. Afternoon is time for class. She called me an hour ago. Eleven apples are in the bag. I walk home in the evening. I read every day. I study for one hour. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "a.m.",
            "after",
            "afternoon",
            "ago",
            "eleven",
            "evening",
            "every",
            "hour"
          ],
          "audio": "audio/vocab_foundation/passages/l3-u01-p1.mp3"
        },
        {
          "id": "l3-u01-p2",
          "title": "Language Tools: Second Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. We talk about our weekend. The story is true. Tell me when you are ready. Where is my book? Why do you like this story? I go to school with my sister. I use this word in a sentence. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "about",
            "true",
            "when",
            "where",
            "why",
            "with",
            "word"
          ],
          "audio": "audio/vocab_foundation/passages/l3-u01-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l3-u01-d1",
            "speaker": "A",
            "text": "Can you use \"a.m.\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l3-u01-d1.mp3"
          },
          {
            "id": "l3-u01-d2",
            "speaker": "B",
            "text": "School starts at eight a.m.",
            "audio": "audio/vocab_foundation/dialogue_lines/l3-u01-d2.mp3"
          },
          {
            "id": "l3-u01-d3",
            "speaker": "A",
            "text": "What can you say with \"after\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l3-u01-d3.mp3"
          },
          {
            "id": "l3-u01-d4",
            "speaker": "B",
            "text": "We play outside after school.",
            "audio": "audio/vocab_foundation/dialogue_lines/l3-u01-d4.mp3"
          },
          {
            "id": "l3-u01-d5",
            "speaker": "A",
            "text": "Can you give me an example with \"afternoon\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l3-u01-d5.mp3"
          },
          {
            "id": "l3-u01-d6",
            "speaker": "B",
            "text": "Afternoon is time for class.",
            "audio": "audio/vocab_foundation/dialogue_lines/l3-u01-d6.mp3"

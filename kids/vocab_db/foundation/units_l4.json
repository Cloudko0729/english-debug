      "passages": [
        {
          "id": "l4-u01-p1",
          "title": "Language Tools: First Reading",
          "type": "guided-reading",
          "theme": "language",
          "text": "Our class is practicing clear English today. Please be quiet. Does he walk to school? I am from Taiwan. The door of the room is open. It is raining, so we stay inside. There are some apples on the table. I can speak English. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "be",
            "does",
            "from",
            "of",
            "so",
            "some",
            "speak"
          ],
          "audio": "audio/vocab_foundation/passages/l4-u01-p1.mp3"
        },
        {
          "id": "l4-u01-p2",
          "title": "Numbers and Time: Second Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "It is a busy day, and we check the time carefully. This book is new. Which bag is yours? I took the wrong bus. Write today's date on the page. He sees eighteen birds. Eighty leaves fall down. Fifteen kids sing a song. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "this",
            "which",
            "wrong",
            "date",
            "eighteen",
            "eighty",
            "fifteen"
          ],
          "audio": "audio/vocab_foundation/passages/l4-u01-p2.mp3"
        }
      ],
      "dialogue": {
        "turns": [
          {
            "id": "l4-u01-d1",
            "speaker": "A",
            "text": "Can you use \"be\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d1.mp3"
          },
          {
            "id": "l4-u01-d2",
            "speaker": "B",
            "text": "Please be quiet.",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d2.mp3"
          },
          {
            "id": "l4-u01-d3",
            "speaker": "A",
            "text": "What can you say with \"does\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d3.mp3"
          },
          {
            "id": "l4-u01-d4",
            "speaker": "B",
            "text": "Does he walk to school?",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d4.mp3"
          },
          {
            "id": "l4-u01-d5",
            "speaker": "A",
            "text": "Can you give me an example with \"from\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d5.mp3"
          },
          {
            "id": "l4-u01-d6",
            "speaker": "B",
            "text": "I am from Taiwan.",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d6.mp3"
          },
          {
            "id": "l4-u01-d7",
            "speaker": "A",
            "text": "How would you use \"of\"?",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u01-d7.mp3"
          },
          {
            "id": "l4-u01-d8",
            "speaker": "B",

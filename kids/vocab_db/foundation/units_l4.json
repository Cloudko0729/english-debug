          {
            "id": "l4-u03-d1",
            "speaker": "A",
            "text": "Can you use \"grandfather\" in a sentence?",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u03-d1.mp3"
          },
          {
            "id": "l4-u03-d2",
            "speaker": "B",
            "text": "My grandfather walks every morning.",
            "audio": "audio/vocab_foundation/dialogue_lines/l4-u03-d2.mp3"

            "grandfather",
            "grandma",
            "grandmother",
            "grandpa",
            "parents",
            "sir",
            "writer"
          ],
          "audio": "audio/vocab_foundation/passages/l4-u03-p1.mp3"
        },
        {
          "id": "l4-u03-p2",
          "title": "Numbers and Time: Second Reading",
          "type": "guided-reading",
          "theme": "numbers_time",
          "text": "It is a busy day, and we check the time carefully. I will visit Grandma tomorrow. There are twelve months in a year. I see twenty chairs. The weekend is fun. The butterfly is near the tree. The panda is eating. She is thirsty after running. After reading, we choose two new words and make our own sentences.",
          "focusWords": [
            "tomorrow",
            "twelve",
            "twenty",
            "weekend",
            "butterfly",
            "panda",
            "thirsty"
          ],
          "audio": "audio/vocab_foundation/passages/l4-u03-p2.mp3"
        }
      ],
